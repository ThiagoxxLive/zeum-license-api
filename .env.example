APP_PORT=8080

DB_HOST=db
DB_PORT=3306
DB_NAME=db_auth
DB_USER=root
DB_PASSWORD=

# Precisa ser IDÊNTICO ao DEFUSE_SECRET do zeum-admin-api: é o mesmo segredo
# usado para criptografar Application.api_key naquele banco.
DEFUSE_SECRET=

# Mesmas variáveis do zeum-admin-api — usadas para buscar a chave pública do
# realm e validar a assinatura dos JWTs emitidos pelo Keycloak.
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
